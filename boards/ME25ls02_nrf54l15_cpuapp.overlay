#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

&pinctrl {
	emf_spis00_default: emf_spis00_default {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 2, 6)>,
				<NRF_PSEL(SPIS_MOSI, 2, 8)>,
				<NRF_PSEL(SPIS_MISO, 2, 9)>,
				<NRF_PSEL(SPIS_CSN, 2, 10)>;
		};
	};

	emf_spis00_sleep: emf_spis00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIS_SCK, 2, 6)>,
				<NRF_PSEL(SPIS_MOSI, 2, 8)>,
				<NRF_PSEL(SPIS_MISO, 2, 9)>,
				<NRF_PSEL(SPIS_CSN, 2, 10)>;
			low-power-enable;
		};
	};
};

&spi00 {
	compatible = "nordic,nrf-spis";
	status = "okay";
	def-char = <0x00>;
	overrun-character = <0x00>;
	pinctrl-0 = <&emf_spis00_default>;
	pinctrl-1 = <&emf_spis00_sleep>;
	pinctrl-names = "default", "sleep";
	/delete-property/ rx-delay-supported;
	/delete-property/ rx-delay;
};
