#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	emf_spi_triggers {
		compatible = "gpio-keys";

		emf_spi_trigger: emf-spi-trigger {
			gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "EMF SPI trigger";
		};
	};
};

&pinctrl {
	emf_spim00_default: emf_spim00_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
		};
	};

	emf_spim00_sleep: emf_spim00_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 2, 1)>,
				<NRF_PSEL(SPIM_MOSI, 2, 2)>,
				<NRF_PSEL(SPIM_MISO, 2, 4)>;
			low-power-enable;
		};
	};
};

&spi00 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&emf_spim00_default>;
	pinctrl-1 = <&emf_spim00_sleep>;
	pinctrl-names = "default", "sleep";
};
